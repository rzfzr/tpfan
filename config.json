// tpfan config, reloaded automatically when saved. Temperatures are AMD Tctl in °C.
// Measured on this E14 Gen 5 (EC register 0x2F):
//   0 = off, 1 = 2200 rpm, 2 = 2500 rpm, 3..7 = 4200 rpm (all identical), 40 = full 6300 rpm,
//   80 = BIOS auto, which uses finer internal speeds (~2100/3300/3600/3800 rpm) but tops out ~3800.
// So: let the BIOS run the normal range, take over only above what it reaches.
{
  "PollMs": 500,
  "SmoothSec": 6,        // average Tctl over ~6 s so boost spikes don't move the fan
  "UpDwellSec": 4,       // at most one step up every 4 s
  "DownHoldSec": 25,     // must be cooler than Down for 25 s before stepping down
  "EmergencyTemp": 95,   // raw Tctl >= 95 for 5 s -> top step (capped at 97 in code)
  "EmergencySec": 5,
  // Top step is 4200 rpm on purpose: only a mode's FanBoost goes above it. The mode's FanUp/FanDown replace its Up/Down.
  "Steps": [
    { "Ec": "80", "Up": 0,  "Down": 0,  "Note": "BIOS auto" },
    { "Ec": "7",  "Up": 85, "Down": 78, "Note": "4200 rpm" }
  ],

  // CPU modes, replacing Universal x86 Tuning Utility's presets. tpfan-bar cycles "Mode" when its letter is clicked.
  // SMU limits (W, A, °C, s) are sent at start, on a mode change, after wake and cable changes, and every ReapplySec.
  // PowerMode: best-performance | balanced | best-efficiency. MaxFreqMHz: plugged-in cap of the active plan, 0 = none
  // (best-efficiency has its own cap, 3500 MHz). Boost: max-performance | power-saving.
  "ReapplySec": 30,
  "Mode": "Performance",
  "Modes": [
    { "Name": "Eco", "TctlTemp": 85, "StapmLimit": 14, "FastLimit": 22, "SlowLimit": 16, "StapmTime": 8, "SlowTime": 30,
      "VrmCurrent": 28, "VrmMaxCurrent": 62, "VrmSocCurrent": 64, "VrmSocMaxCurrent": 70, "Boost": "power-saving",
      "PowerMode": "best-efficiency", "MaxFreqMHz": 4000, "FanUp": 90, "FanDown": 82 },
    { "Name": "Performance", "TctlTemp": 97, "StapmLimit": 24, "FastLimit": 45, "SlowLimit": 28, "StapmTime": 20, "SlowTime": 45,
      "VrmCurrent": 28, "VrmMaxCurrent": 62, "VrmSocCurrent": 64, "VrmSocMaxCurrent": 70, "Boost": "max-performance",
      "PowerMode": "best-performance", "MaxFreqMHz": 4000, "FanUp": 90, "FanDown": 82 },
    { "Name": "Maximum", "TctlTemp": 99, "StapmLimit": 35, "FastLimit": 50, "SlowLimit": 35, "StapmTime": 20, "SlowTime": 45,
      "VrmCurrent": 40, "VrmMaxCurrent": 70, "VrmSocCurrent": 64, "VrmSocMaxCurrent": 70, "Boost": "max-performance",
      "PowerMode": "best-performance", "MaxFreqMHz": 0, "FanUp": 78, "FanDown": 70,
      // Faster fan for long all-core loads (builds) only: smoothed Tctl >= 97 and CPU load >= 90 % for 120 s turns it
      // on; it stays at least 120 s and goes back to 4200 rpm after 30 s with load < 60 % or Tctl < 90.
      "FanBoost": { "Ec": "40", "Note": "6300 rpm", "Temp": 97, "Load": 90, "AfterSec": 120, "MinSec": 120,
                    "ExitLoad": 60, "ExitTemp": 90, "ExitSec": 30 } }
  ]
}
