<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="modules\LpcACPIEC.bin" LogicalName="LpcACPIEC.bin" />
    <EmbeddedResource Include="modules\AMDFamily17.bin" LogicalName="AMDFamily17.bin" />
    <EmbeddedResource Include="modules\RyzenSMU.bin" LogicalName="RyzenSMU.bin" />
    <EmbeddedResource Include="modules\LpcIO.bin" LogicalName="LpcIO.bin" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>
</Project>
